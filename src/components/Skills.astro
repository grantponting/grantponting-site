---
import skillsData from "../data/skills.json";

const categories = [
    { title: "Software Development", skills: skillsData.development },
    { title: "Quality Engineering", skills: skillsData.quality },
    { title: "Cloud & Delivery", skills: skillsData.delivery },
];
---

<section id="skills">
    <div class="container">
        <header class="section-header">
            <div>
                <p class="section-kicker">Capabilities</p>
                <h2>Tools used to build, test, and ship.</h2>
            </div>
            <p>
                A cross-functional toolkit spanning product development, automation,
                infrastructure, and quality strategy.
            </p>
        </header>

        <div class="skills-grid">
            {
                categories.map((category, index) => (
                    <article class="skill-category">
                        <div class="category-index">0{index + 1}</div>
                        <h3>{category.title}</h3>
                        <div class="skill-list">
                            {category.skills.map((skill) => <span>{skill}</span>)}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--border-strong);
        border-bottom: 1px solid var(--border-strong);
    }

    .skill-category {
        min-width: 0;
        padding: 2rem;
    }

    .skill-category + .skill-category { border-left: 1px solid var(--border-strong); }

    .category-index {
        color: var(--accent-primary);
        font-family: var(--font-mono);
        font-size: 0.72rem;
    }

    h3 {
        margin-top: 1.5rem;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
    }

    .skill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
    }

    .skill-list span {
        padding: 0.42rem 0.62rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.78rem;
    }

    @media (max-width: 820px) {
        .skills-grid { grid-template-columns: 1fr; }
        .skill-category + .skill-category { border-left: 0; border-top: 1px solid var(--border-strong); }
        .skill-category { padding: 1.75rem 0; }
    }
</style>
