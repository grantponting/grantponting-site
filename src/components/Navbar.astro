<nav class="navbar" aria-label="Primary navigation">
    <div class="container navbar-content">
        <a href="#hero" class="logo" aria-label="Grant Ponting, back to top">GP<span>.</span></a>
        <div class="nav-links">
            <a href="#projects">Work</a>
            <a href="#experience">Experience</a>
            <a href="#skills">Skills</a>
            <a href="#about">About</a>
            <a href="#contact" class="btn btn-primary nav-contact">Contact</a>
        </div>
        <details class="mobile-nav">
            <summary aria-label="Navigation menu">Menu</summary>
            <div class="mobile-menu">
                <a href="#projects">Work</a>
                <a href="#experience">Experience</a>
                <a href="#skills">Skills</a>
                <a href="#about">About</a>
                <a href="#contact">Contact</a>
            </div>
        </details>
    </div>
</nav>

<style>
    .navbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 1000;
        padding: 1.4rem 0;
        border-bottom: 1px solid transparent;
        transition: padding var(--transition-medium), background var(--transition-medium), border-color var(--transition-medium);
    }

    .navbar.scrolled {
        padding: 0.8rem 0;
        background: rgba(17, 19, 21, 0.92);
        border-color: var(--border-subtle);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }

    .navbar-content,
    .nav-links { display: flex; align-items: center; }
    .navbar-content { justify-content: space-between; gap: 1.5rem; }

    .logo {
        color: var(--text-primary);
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.04em;
    }

    .logo span { color: var(--accent-primary); }
    .nav-links { gap: 1.7rem; }

    .nav-links > a:not(.btn) {
        color: var(--text-secondary);
        font-size: 0.86rem;
        font-weight: 500;
    }

    .nav-links > a:not(.btn):hover { color: var(--text-primary); }
    .nav-contact { padding: 0.62rem 1rem; }

    .mobile-nav { display: none; position: relative; }

    .mobile-nav summary {
        padding: 0.62rem 0.9rem;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-md);
        color: var(--text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker { display: none; }

    .mobile-nav[open] summary {
        border-color: var(--accent-primary);
        background: rgba(168, 198, 134, 0.07);
    }

    .mobile-menu {
        position: absolute;
        top: calc(100% + 0.65rem);
        right: 0;
        width: min(18rem, calc(100vw - 2rem));
        padding: 0.5rem;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-md);
        background: var(--bg-primary);
        box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.35);
    }

    .mobile-menu a {
        display: block;
        padding: 0.75rem 0.8rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .mobile-menu a:hover,
    .mobile-menu a:focus-visible {
        background: var(--surface-raised);
        color: var(--text-primary);
    }

    @media (max-width: 720px) {
        .nav-links { display: none; }
        .mobile-nav { display: block; }
    }
</style>

<script>
    const navbar = document.querySelector(".navbar");

    if (navbar) {
        let ticking = false;
        const updateNavbar = () => {
            navbar.classList.toggle("scrolled", window.scrollY > 32);
            ticking = false;
        };

        window.addEventListener("scroll", () => {
            if (!ticking) {
                requestAnimationFrame(updateNavbar);
                ticking = true;
            }
        }, { passive: true });

        updateNavbar();
    }

    const mobileNav = document.querySelector(".mobile-nav");
    mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => mobileNav.removeAttribute("open"));
    });
</script>
