---
import experienceData from "../data/experience.json";
---

<section id="experience">
    <div class="container">
        <header class="section-header">
            <div>
                <p class="section-kicker">Experience</p>
                <h2>Shipping software and raising the quality bar.</h2>
            </div>
            <p>
                Current contract development work runs alongside a full-time quality
                engineering role.
            </p>
        </header>

        <div class="experience-list">
            {
                experienceData.map((job) => (
                    <article class="experience-card">
                        <div class="experience-meta">
                            <p class="period">{job.period}</p>
                            <span class="engagement">{job.engagement}</span>
                        </div>

                        <div class="experience-body">
                            <header>
                                <h3>{job.role}</h3>
                                <p class="company">{job.company}</p>
                            </header>
                            <p class="summary">{job.summary}</p>
                            <ul>
                                {job.highlights.map((highlight) => <li>{highlight}</li>)}
                            </ul>
                            <div class="tech-list" aria-label={`Technologies used at ${job.company}`}>
                                {job.technologies.map((technology) => <span>{technology}</span>)}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .experience-list {
        border-top: 1px solid var(--border-strong);
    }

    .experience-card {
        display: grid;
        grid-template-columns: minmax(11rem, 0.35fr) minmax(0, 1fr);
        gap: clamp(2rem, 6vw, 6rem);
        padding: 2.5rem 0;
        border-bottom: 1px solid var(--border-strong);
    }

    .experience-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.7rem;
    }

    .period {
        color: var(--text-secondary);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .engagement {
        padding: 0.3rem 0.55rem;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .experience-body { max-width: 48rem; }

    .experience-body header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 0.75rem;
    }

    .experience-body h3 {
        font-size: clamp(1.35rem, 2.3vw, 1.75rem);
        letter-spacing: -0.03em;
    }

    .company { color: var(--accent-primary); font-weight: 600; }

    .summary {
        margin-top: 0.85rem;
        color: var(--text-secondary);
        font-size: 1.03rem;
    }

    ul {
        display: grid;
        gap: 0.7rem;
        margin: 1.3rem 0 0 1.15rem;
        color: var(--text-secondary);
    }

    li { padding-left: 0.35rem; }
    li::marker { color: var(--accent-primary); }

    .tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 1.5rem;
    }

    .tech-list span {
        padding: 0.35rem 0.55rem;
        background: var(--surface-raised);
        border-radius: var(--radius-sm);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
    }

    @media (max-width: 700px) {
        .experience-card { grid-template-columns: 1fr; gap: 1.25rem; }
        .experience-meta { flex-direction: row; align-items: center; justify-content: space-between; }
    }
</style>
