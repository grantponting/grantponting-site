<section id="hero" class="hero">
    <canvas class="hero-particles" aria-hidden="true"></canvas>
    <div class="container hero-content">
        <p class="eyebrow">Hello, I’m</p>
        <h1>Grant <span>Ponting</span></h1>
        <p class="role">Software Developer & Quality Engineer</p>
        <p class="sub-lead">
            I build maintainable web applications, automation systems, and
            reliable delivery pipelines.
        </p>
        <div class="cta-group">
            <a href="#projects" class="btn btn-primary">View Selected Work</a>
            <a href="/grant_resume.pdf" class="btn btn-outline" download>Download Résumé</a>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        min-height: 82vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-top: 7rem;
    }

    .hero::before {
        position: absolute;
        z-index: 0;
        inset: 0;
        background: radial-gradient(ellipse 42rem 31rem at 82% 43%, rgba(113, 143, 104, 0.12), transparent 72%);
        content: "";
    }

    .hero-particles {
        position: absolute;
        z-index: 1;
        inset: 0;
        width: 100%;
        height: 100%;
        mask-image: linear-gradient(90deg, transparent 0%, transparent 34%, black 64%, black 100%);
        pointer-events: none;
    }


    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 52rem;
    }

    .eyebrow {
        color: var(--accent-primary);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }


    h1 {
        margin-top: 0.75rem;
        font-size: clamp(3.75rem, 8vw, 6.5rem);
        letter-spacing: -0.07em;
        line-height: 0.95;
    }

    h1 span {
        color: var(--accent-primary);
    }

    .role {
        margin-top: 1.5rem;
        color: var(--text-primary);
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .sub-lead {
        max-width: 38rem;
        margin-top: 0.85rem;
        color: var(--text-secondary);
        font-size: clamp(1rem, 1.6vw, 1.15rem);
        line-height: 1.7;
    }

    .cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 2rem;
    }

    @media (max-width: 600px) {
        .hero {
            min-height: auto;
            padding-top: 8.5rem;
            padding-bottom: 5rem;
        }

        .hero-particles {
            opacity: 0.65;
            mask-image: linear-gradient(90deg, transparent 0%, transparent 12%, black 78%, black 100%);
        }


        h1 {
            font-size: clamp(3.1rem, 15vw, 4rem);
        }

        .role {
            margin-top: 1.25rem;
        }
    }
</style>

<script>
    const canvas = document.querySelector<HTMLCanvasElement>(".hero-particles");
    const hero = document.querySelector<HTMLElement>(".hero");

    if (canvas && hero) {
        const context = canvas.getContext("2d");
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const compact = window.matchMedia("(max-width: 600px)").matches;
        const particleCount = compact ? 12 : 28;
        let width = 0;
        let height = 0;
        let frame = 0;
        let visible = true;

        type Particle = { x: number; y: number; vx: number; vy: number; radius: number };
        const particles: Particle[] = Array.from({ length: particleCount }, () => ({
            x: Math.random(),
            y: Math.random(),
            vx: (Math.random() - 0.5) * 0.00022,
            vy: (Math.random() - 0.5) * 0.00022,
            radius: 0.7 + Math.random(),
        }));

        const resize = () => {
            const bounds = hero.getBoundingClientRect();
            const ratio = Math.min(window.devicePixelRatio || 1, 2);
            width = bounds.width;
            height = bounds.height;
            canvas.width = Math.round(width * ratio);
            canvas.height = Math.round(height * ratio);
            context?.setTransform(ratio, 0, 0, ratio, 0, 0);
        };

        const draw = (advance = true) => {
            if (!context) return;
            context.clearRect(0, 0, width, height);

            for (let index = 0; index < particles.length; index += 1) {
                const particle = particles[index];
                if (advance) {
                    particle.x = (particle.x + particle.vx + 1) % 1;
                    particle.y = (particle.y + particle.vy + 1) % 1;
                }

                const x = particle.x * width;
                const y = particle.y * height;
                context.fillStyle = "rgba(168, 198, 134, 0.48)";
                context.beginPath();
                context.arc(x, y, particle.radius, 0, Math.PI * 2);
                context.fill();

                for (let otherIndex = index + 1; otherIndex < particles.length; otherIndex += 1) {
                    const other = particles[otherIndex];
                    const otherX = other.x * width;
                    const otherY = other.y * height;
                    const distance = Math.hypot(x - otherX, y - otherY);
                    const limit = compact ? 82 : 118;

                    if (distance < limit) {
                        context.strokeStyle = `rgba(168, 198, 134, ${0.1 * (1 - distance / limit)})`;
                        context.lineWidth = 0.75;
                        context.beginPath();
                        context.moveTo(x, y);
                        context.lineTo(otherX, otherY);
                        context.stroke();
                    }
                }
            }
        };

        const animate = () => {
            if (!visible || document.hidden) {
                frame = 0;
                return;
            }
            draw(true);
            frame = requestAnimationFrame(animate);
        };

        resize();
        draw(false);

        if (!reduceMotion) frame = requestAnimationFrame(animate);

        new ResizeObserver(() => {
            resize();
            if (reduceMotion) draw(false);
        }).observe(hero);

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (visible && !reduceMotion && !frame) frame = requestAnimationFrame(animate);
        }).observe(hero);

        document.addEventListener("visibilitychange", () => {
            if (!document.hidden && visible && !reduceMotion && !frame) {
                frame = requestAnimationFrame(animate);
            }
        });
    }
</script>
