---
import projectsData from "../data/projects.json";
---

<section id="projects" class="section-tinted">
    <div class="container">
        <header class="section-header">
            <div>
                <p class="section-kicker">Selected work</p>
                <h2>Practical systems built for real use.</h2>
            </div>
            <p>
                Client delivery and automation work spanning production interfaces,
                maintainable test architecture, and cloud deployment.
            </p>
        </header>

        <div class="projects-grid">
            {
                projectsData.map((project, index) => (
                    <article class="project-card">
                        <div class="project-number">0{index + 1}</div>
                        <p class="project-type">{project.type}</p>
                        <h3>{project.title}</h3>
                        <p class="project-description">{project.description}</p>

                        <ul>
                            {project.highlights.map((highlight) => <li>{highlight}</li>)}
                        </ul>

                        <div class="project-footer">
                            <div class="stack-list" aria-label={`${project.title} technology stack`}>
                                {project.stack.map((technology) => <span>{technology}</span>)}
                            </div>
                            <div class="project-links">
                                {project.siteLink && (
                                    <a href={project.siteLink} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.title}, opens in a new tab`}>
                                        Live site ↗
                                    </a>
                                )}
                                {project.codeLink && (
                                    <a href={project.codeLink} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} source code, opens in a new tab`}>
                                        Source ↗
                                    </a>
                                )}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .project-card {
        min-width: 0;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-lg);
        background: var(--surface);
        display: flex;
        flex-direction: column;
    }

    .project-number {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.76rem;
    }

    .project-type {
        margin-top: 2.5rem;
        color: var(--accent-primary);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h3 {
        margin-top: 0.5rem;
        font-size: clamp(1.6rem, 3vw, 2rem);
        letter-spacing: -0.04em;
    }

    .project-description {
        margin-top: 0.9rem;
        color: var(--text-secondary);
        font-size: 1.02rem;
        line-height: 1.7;
    }

    ul {
        display: grid;
        gap: 0.65rem;
        margin: 1.5rem 0 0 1.15rem;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    li { padding-left: 0.25rem; }
    li::marker { color: var(--accent-secondary); }

    .project-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
        margin-top: auto;
        padding-top: 2rem;
    }

    .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .stack-list span {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
    }

    .stack-list span + span::before {
        content: "/";
        margin-right: 0.45rem;
        color: var(--border-strong);
    }

    .project-links { display: flex; gap: 1rem; }

    .project-links a {
        color: var(--text-primary);
        font-size: 0.88rem;
        font-weight: 600;
    }

    .project-links a:hover { color: var(--accent-primary); }

    @media (max-width: 760px) {
        .projects-grid { grid-template-columns: 1fr; }
        .project-type { margin-top: 1.75rem; }
    }
</style>
